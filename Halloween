-- ─── minigame message listener ────────────────────────────────────────────────
local function hookMinigame()
    local msg = getRemote("MinigameAPI/MessageClient")
    if not msg then return end
    msg.OnClientEvent:Connect(function(gameId, messageName, ...)
        local args = { ... }
        if messageName == "join_accepted" then
            State.joinAccepted = true
            State.gameId = gameId
        elseif messageName == "join_minigame" then
            State.gameId = gameId
            State.inRound = true
            State.mode = "In Round"
        elseif messageName == "enter_game" then
            local info = args[1]
            if type(info) == "table" then
                State.enter = info
            end
        elseif messageName == "ghost_clusters_score" then
            local pts = tonumber(args[1]) or 0
            State.score = State.score + pts
            State.caught = State.caught + 1
        elseif messageName == "leave_game" then
            State.leave = args[1]
            State.inRound = false
            State.mode = "Lobby — Waiting"
        end
    end)
end
pcall(hookMinigame)

-- ─── find ghosts / targets ────────────────────────────────────────────────────
local function findGhosts()
    local folder = workspace:FindFirstChild(GHOSTS_FOLDER)
    local list = {}
    if not folder then return list end
    for _, child in ipairs(folder:GetChildren()) do
        local id = string.match(child.Name, GHOST_NAME_PATTERN)
        if id then
            local size = string.match(child.Name, "^Ghost_(%a+)_")
            table.insert(list, { id = id, model = child, size = size, boss = size == BOSS_SIZE })
        end
    end
    return list
end

local function pickTarget()
    local root = myRoot()
    if not root then return nil end
    local best, bestD, boss
    for _, g in ipairs(findGhosts()) do
        local pos = modelPos(g.model)
        if pos then
            local t = { kind = "ghost", id = g.id, position = pos, model = g.model, boss = g.boss }
            if g.boss then
                boss = boss or t
            else
                local d = distance(pos, root.Position)
                if not best or d < bestD then best, bestD = t, d end
            end
        end
    end
    return best or boss
end

local function newToken()
    local ok, guid = pcall(function()
        return HttpService:GenerateGUID(false)
    end)
    return string.lower(ok and tostring(guid) or string.format("%08x-%012x", math.random(0, 0x7fffffff), os.time()))
end

-- ─── one Ghost Gallery round ──────────────────────────────────────────────────
local function runRound(startUnix)
    State.mode = "Traveling"
    State.score = 0
    State.caught = 0
    State.bossHits = 0
    State.joinAccepted = false
    State.inRound = false
    State.leave = nil
    State.enter = nil
    State.gameId = nil

    goToManor()
    State.mode = "Joining"

    -- wait until ~3s before start
    local waitUntil = startUnix - 3
    while serverNow() < waitUntil and State.running do
        State.nextGameIn = math.max(0, math.floor(startUnix - serverNow()))
        task.wait(0.5)
    end
    if not State.running then return end

    -- join spam
    local joinDeadline = now() + 30
    while not State.joinAccepted and not State.gameId and now() < joinDeadline and State.running do
        fire("MinigameAPI/AttemptJoin", nil, MINIGAME_ID, true, nil)
        task.wait(2.5)
    end
    if not State.joinAccepted and not State.gameId then
        State.mode = "Join failed"
        return
    end

    -- wait to enter round
    local enterDeadline = now() + 40
    while not State.inRound and now() < enterDeadline and State.running do
        if State.gameId then
            fire("MinigameAPI/AttemptJoin", nil, State.gameId, true, nil)
        end
        task.wait(1)
    end
    if not State.inRound then
        State.mode = "Did not enter"
        return
    end

    State.mode = "Vacuuming"
    local endTime = (State.enter and State.enter.end_time) or (serverNow() + 170)

    -- equip vacuum if present in inventory (loaned)
    -- farm uses ToolAPI/Equip — best-effort
    task.wait(1)

    while State.running and not State.leave and serverNow() < endTime + 5 do
        local target = pickTarget()
        if not target then
            task.wait(0.4)
        else
            local standOff = target.boss and BOSS_STAND_OFF or 8
            local root = myRoot()
            if root and target.position and distance(target.position, root.Position) > VACUUM_REACH then
                teleportTo(target.position, standOff)
                task.wait(0.15)
            end

            -- UseTool START (best-effort — vacuum unique unknown when loaned)
            local token = newToken()
            local payload = { use_token = token, ghost_id = target.id }
            local gameId = State.gameId

            for send = 1, 8 do
                if not State.running or State.leave then break end
                if target.model and target.model.Parent == nil then break end
                -- prefer guards over boss mid-use
                if target.boss and send > 1 then
                    local other = pickTarget()
                    if other and not other.boss then break end
                end
                if send % 3 == 0 and target.model then
                    local p = modelPos(target.model)
                    if p then teleportTo(p, standOff) end
                end
                fire("MinigameAPI/MessageServer", nil, gameId, "start_contribute", payload)
                if target.boss then State.bossHits = State.bossHits + 1 end
                task.wait(0.3)
            end
            fire("MinigameAPI/MessageServer", nil, gameId, "stop_contribute", payload)
        end
    end

    -- wait leave
    local leaveDeadline = now() + 25
    while not State.leave and now() < leaveDeadline and State.running do
        task.wait(0.5)
    end
    State.mode = "Lobby — Waiting"
    State.inRound = false
    pcall(goHome)
end

-- ─── main autofarm loop ───────────────────────────────────────────────────────
local function autofarmLoop()
    while State.running do
        local cycle = myData(KEY_CYCLE)
        local start = nextRoundStart(cycle)
        State.nextStartUnix = start

        if not start then
            State.mode = "No cycle data"
            State.nextGameIn = 0
            task.wait(5)
        else
            local sn = serverNow()
            local left = start - sn
            State.nextGameIn = math.max(0, math.floor(left))

            if left <= GHOST_LEAD and left > -15 then
                State.mode = "Starting soon"
                runRound(start)
                -- after round, wait a bit before next cycle read
                task.wait(5)
            else
                State.mode = "Lobby — Waiting"
                task.wait(1)
            end
        end
    end
    State.mode = "Stopped"
end

local function startAutofarm()
    if State.running then return end
    if game.PlaceId ~= PLACE_ID then
        State.mode = "Not in Adopt Me"
        return
    end
    State.running = true
    State.mode = "Lobby — Waiting"
    State.thread = task.spawn(autofarmLoop)
end

local function stopAutofarm()
    State.running = false
    State.mode = "Stopped"
end

