-- ─── helpers ──────────────────────────────────────────────────────────────────
local function now()
    return os.clock()
end

local function serverNow()
    -- approximate: workspace:GetServerTimeNow if available
    local ok, t = pcall(function()
        return workspace:GetServerTimeNow()
    end)
    if ok and type(t) == "number" then return t end
    return os.time()
end

local function getRemote(name, folder)
    folder = folder or API_FOLDER
    local root = ReplicatedStorage:FindFirstChild(folder)
    if not root then return nil end
    local remote = root:FindFirstChild(name)
    if remote then return remote end
    -- nested path like "MinigameAPI/AttemptJoin"
    local cur = root
    for part in string.gmatch(name, "[^/]+") do
        cur = cur and cur:FindFirstChild(part)
    end
    return cur
end

local function fire(remoteName, folder, ...)
    local r = getRemote(remoteName, folder)
    if not r then return false, "missing " .. tostring(remoteName) end
    local args = { ... }
    local ok, res
    if r:IsA("RemoteEvent") then
        ok, res = pcall(function() r:FireServer(table.unpack(args)) end)
    elseif r:IsA("RemoteFunction") then
        ok, res = pcall(function() return r:InvokeServer(table.unpack(args)) end)
    else
        return false, "not a remote"
    end
    return ok, res
end

local function myRoot()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function teleportTo(pos, standOff)
    local root = myRoot()
    if not root or not pos then return false end
    local offset = standOff or 0
    local target = pos
    if offset > 0 then
        local dir = (root.Position - pos)
        if dir.Magnitude > 0.1 then
            dir = dir.Unit * offset
            target = pos + dir
        end
    end
    root.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
    return true
end

local function distance(a, b)
    return (a - b).Magnitude
end

local function modelPos(model)
    local ok, p = pcall(function() return model:GetPivot().Position end)
    return ok and p or nil
end

-- ClientData (same path as farm)
local ClientData
local function getClientData()
    if ClientData then return ClientData end
    local ok, mod = pcall(function()
        local m = require(ReplicatedStorage:WaitForChild("ClientModules"):WaitForChild("Core"):WaitForChild("ClientData"))
        return m
    end)
    if ok then ClientData = mod end
    return ClientData
end

local function myData(key)
    local cd = getClientData()
    if not cd or type(cd.get) ~= "function" then return nil end
    local ok, data = pcall(function()
        return cd.get()  -- or get_data depending on version
    end)
    if not ok or type(data) ~= "table" then
        ok, data = pcall(function()
            return cd.get_data and cd.get_data() or cd:get_data()
        end)
    end
    if type(data) ~= "table" then return nil end
    -- try LocalPlayer name key
    local me = data[LocalPlayer.Name] or data
    if type(me) == "table" and key then
        return me[key]
    end
    return me
end

local function nextRoundStart(cycle)
    local start = type(cycle) == "table" and tonumber(cycle.timestamp)
    if not start then return nil end
    local sn = serverNow()
    while start + 20 < sn do
        start = start + ROUND_SECONDS
    end
    return start
end

